#!/bin/sh
# dsFlower post-install configuration script
# Runs automatically during R CMD INSTALL on Unix systems.
#
# Creates Python virtual environments for each ML framework so that
# SuperNodes have all dependencies ready at runtime. This runs ONCE
# at package install time, not on every session.
#
# If uv is not installed, an administrator can bootstrap one immutable release
# by setting DSFLOWER_UV_VERSION and DSFLOWER_UV_SHA256. Mutable curl|sh
# installers are deliberately not executed.

# Resolve a WRITABLE venv root so install works with ZERO root. Honor an
# explicit DSFLOWER_VENV_ROOT; otherwise pick the first creatable location,
# cascading from system paths down to a user-space dir. The user-space path
# mirrors tools::R_user_dir("dsFlower","data") so .onLoad resolves the same
# location at runtime.
if [ -n "${DSFLOWER_VENV_ROOT:-}" ]; then
  VENV_ROOT="${DSFLOWER_VENV_ROOT}"
else
  _user_data="${XDG_DATA_HOME:-${HOME}/.local/share}/R/dsFlower/venvs"
  VENV_ROOT=""
  for _cand in "/var/lib/dsflower/venvs" "/srv/dsflower/venvs" "${_user_data}"; do
    if mkdir -p "${_cand}" 2>/dev/null; then VENV_ROOT="${_cand}"; break; fi
  done
  VENV_ROOT="${VENV_ROOT:-/var/lib/dsflower/venvs}"
fi
DSFLOWER_HOME="$(dirname "${VENV_ROOT}")"
LOG_PREFIX="[dsFlower configure]"
PYTHON_VERSION="${DSFLOWER_PYTHON_VERSION:-3.11}"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

log_info() { echo "${LOG_PREFIX} $*"; }
log_warn() { echo "${LOG_PREFIX} WARNING: $*" >&2; }

check_imports() {
  _python="$1"; shift
  for _module in "$@"; do
    "${_python}" -c "import ${_module}" 2>/dev/null || return 1
  done
  return 0
}

deps_hash() {
  "${PYTHON}" - "$@" <<'PY'
import hashlib
import sys

deps = sorted(sys.argv[1:])
print(hashlib.sha256("\n".join(deps).encode("utf-8")).hexdigest())
PY
}

file_hash() {
  "${PYTHON}" - "$1" <<'PY'
import hashlib
import sys

h = hashlib.sha256()
with open(sys.argv[1], "rb") as stream:
    for block in iter(lambda: stream.read(1024 * 1024), b""):
        h.update(block)
print(h.hexdigest())
PY
}

download_file() {
  _url="$1"; _target="$2"
  if command -v curl >/dev/null 2>&1; then
    curl --proto '=https' --tlsv1.2 -LsSf -o "${_target}" "${_url}"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "${_target}" "${_url}"
  else
    return 1
  fi
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 "$1" | awk '{print $NF}'
  else
    return 1
  fi
}

# ---------------------------------------------------------------------------
# Bootstrap: ensure uv + Python are available
# ---------------------------------------------------------------------------

ensure_uv() {
  # 1. Already on PATH?
  UV="$(command -v uv 2>/dev/null || true)"
  if [ -n "${UV}" ] && [ -x "${UV}" ]; then return 0; fi

  # 2. Common install locations
  for _p in "${HOME}/.local/bin/uv" "${HOME}/.cargo/bin/uv" "/usr/local/bin/uv"; do
    if [ -x "${_p}" ]; then UV="${_p}"; return 0; fi
  done

  # 3. Download one administrator-pinned release and verify it before extraction.
  _version="${DSFLOWER_UV_VERSION:-}"
  _expected="${DSFLOWER_UV_SHA256:-}"
  if [ -z "${_version}" ] || [ -z "${_expected}" ]; then
    log_warn "uv is absent; refusing a mutable bootstrap. Install uv through the OS,"
    log_warn "or set DSFLOWER_UV_VERSION and DSFLOWER_UV_SHA256 for an audited release."
    return 1
  fi
  if ! printf '%s' "${_version}" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$'; then
    log_warn "Invalid DSFLOWER_UV_VERSION release tag."
    return 1
  fi
  case "${_expected}" in *[!0-9A-Fa-f]*|'')
    log_warn "DSFLOWER_UV_SHA256 must be 64 hexadecimal characters."; return 1 ;;
  esac
  if [ "${#_expected}" -ne 64 ]; then
    log_warn "DSFLOWER_UV_SHA256 must be 64 hexadecimal characters."
    return 1
  fi

  case "$(uname -s 2>/dev/null)" in
    Darwin) _os="apple-darwin" ;;
    Linux) _os="unknown-linux-gnu" ;;
    *) log_warn "Unsupported OS for uv bootstrap."; return 1 ;;
  esac
  case "$(uname -m 2>/dev/null)" in
    x86_64|amd64) _arch="x86_64" ;;
    aarch64|arm64) _arch="aarch64" ;;
    *) log_warn "Unsupported architecture for uv bootstrap."; return 1 ;;
  esac

  _triple="${_arch}-${_os}"
  _url="https://github.com/astral-sh/uv/releases/download/${_version}/uv-${_triple}.tar.gz"
  _tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/dsflower-uv.XXXXXX")" || return 1
  _archive="${_tmp_dir}/uv.tar.gz"
  log_info "Downloading pinned uv ${_version} (${_triple})..."
  if ! download_file "${_url}" "${_archive}"; then
    rm -rf "${_tmp_dir}"
    log_warn "Failed to download pinned uv release."
    return 1
  fi
  _actual="$(sha256_file "${_archive}" 2>/dev/null || true)"
  if [ -z "${_actual}" ] || [ "$(printf '%s' "${_actual}" | tr 'A-F' 'a-f')" != "$(printf '%s' "${_expected}" | tr 'A-F' 'a-f')" ]; then
    rm -rf "${_tmp_dir}"
    log_warn "uv archive SHA-256 mismatch; refusing to execute it."
    return 1
  fi
  _member="uv-${_triple}/uv"
  if ! tar -xzf "${_archive}" -C "${_tmp_dir}" "${_member}" 2>/dev/null; then
    rm -rf "${_tmp_dir}"
    log_warn "Verified uv archive did not contain ${_member}."
    return 1
  fi
  mkdir -p "${HOME}/.local/bin" || { rm -rf "${_tmp_dir}"; return 1; }
  UV="${HOME}/.local/bin/uv"
  if ! cp "${_tmp_dir}/${_member}" "${UV}.tmp" ||
     ! chmod 0755 "${UV}.tmp" || ! mv "${UV}.tmp" "${UV}"; then
    rm -f "${UV}.tmp"
    rm -rf "${_tmp_dir}"
    log_warn "Failed to install verified uv binary."
    return 1
  fi
  rm -rf "${_tmp_dir}"
  log_info "uv installed: $(${UV} --version)"
  return 0
}

ensure_python() {
  # uv provides Python -- no system Python needed
  if [ -z "${UV}" ] || [ ! -x "${UV}" ]; then
    log_warn "No uv available. Cannot provision Python."
    return 1
  fi

  if ! printf '%s' "${PYTHON_VERSION}" | grep -Eq '^[0-9]+\.[0-9]+(\.[0-9]+)?$'; then
    log_warn "DSFLOWER_PYTHON_VERSION must be major.minor or major.minor.patch."
    return 1
  fi

  # Check if uv already manages the requested Python.
  PYTHON="$("${UV}" python find "${PYTHON_VERSION}" 2>/dev/null || true)"
  if [ -n "${PYTHON}" ] && [ -x "${PYTHON}" ]; then
    log_info "Python: ${PYTHON} ($("${PYTHON}" --version 2>&1 | head -1))"
    return 0
  fi

  log_info "Installing Python ${PYTHON_VERSION} via uv..."
  "${UV}" python install "${PYTHON_VERSION}" --quiet 2>&1 || true

  PYTHON="$("${UV}" python find "${PYTHON_VERSION}" 2>/dev/null || true)"
  if [ -n "${PYTHON}" ] && [ -x "${PYTHON}" ]; then
    log_info "Python installed: ${PYTHON} ($("${PYTHON}" --version 2>&1 | head -1))"
    return 0
  fi

  log_warn "Failed to install Python via uv."
  return 1
}

# --- Run bootstrap ---

ensure_uv || {
  log_warn "uv not available. Cannot proceed."
  log_warn "Install uv: https://docs.astral.sh/uv/"
  exit 0
}

ensure_python || {
  log_warn "No Python available. Skipping environment setup."
  exit 0
}

USE_UV=true

# Optional production lock. uv's --require-hashes rejects unpinned or unhashed
# transitive dependencies, so this file must describe the complete environment.
PYTHON_LOCK="${DSFLOWER_PYTHON_LOCK:-}"
case "$(printf '%s' "${DSFLOWER_REQUIRE_PYTHON_LOCK:-0}" | tr 'A-Z' 'a-z')" in
  1|true|yes)
    if [ -z "${PYTHON_LOCK}" ]; then
      log_warn "DSFLOWER_REQUIRE_PYTHON_LOCK is enabled but DSFLOWER_PYTHON_LOCK is unset."
      exit 0
    fi
    ;;
  0|false|no|'') ;;
  *) log_warn "DSFLOWER_REQUIRE_PYTHON_LOCK must be true or false."; exit 0 ;;
esac
if [ -n "${PYTHON_LOCK}" ]; then
  if [ ! -f "${PYTHON_LOCK}" ] || [ ! -r "${PYTHON_LOCK}" ]; then
    log_warn "DSFLOWER_PYTHON_LOCK is not a readable regular file."
    exit 0
  fi
  PYTHON_LOCK_HASH="$(file_hash "${PYTHON_LOCK}" 2>/dev/null || true)"
  if [ -z "${PYTHON_LOCK_HASH}" ]; then
    log_warn "Could not hash DSFLOWER_PYTHON_LOCK."
    exit 0
  fi
  log_info "Using hash-locked Python requirements (${PYTHON_LOCK_HASH})."
fi

# Check venv root
mkdir -p "${VENV_ROOT}" 2>/dev/null || {
  log_warn "Cannot create ${VENV_ROOT}. Skipping."
  exit 0
}
mkdir -p "${DSFLOWER_HOME}/supernode_pids" 2>/dev/null || true
if id rock >/dev/null 2>&1; then
  chown rock:rock "${DSFLOWER_HOME}/supernode_pids" 2>/dev/null || true
fi
chmod 775 "${DSFLOWER_HOME}/supernode_pids" 2>/dev/null || true
log_info "Venv root: ${VENV_ROOT}"

# ---------------------------------------------------------------------------
# Installer functions
# ---------------------------------------------------------------------------

create_venv() {
  local name="$1"
  local venv_path="${VENV_ROOT}/${name}"
  if [ -d "${venv_path}" ] && [ -f "${venv_path}/.dsflower_ready" ]; then
    log_info "  ${name}: already provisioned, skipping."
    return 0
  fi
  log_info "  ${name}: creating venv..."
  rm -rf "${venv_path}"
  if [ "${USE_UV}" = true ]; then
    "${UV}" venv --python "${PYTHON}" "${venv_path}" >/dev/null 2>&1
  else
    "${PYTHON}" -m venv --system-site-packages "${venv_path}"
  fi
}

# TRUE when a usable NVIDIA GPU is visible to this container (the single check
# used to pick CUDA-vs-CPU builds for torch). Force with
# DSFLOWER_FORCE_GPU=1/0. Mirrors R .gpu_present.
gpu_present() {
  case "$(printf '%s' "${DSFLOWER_FORCE_GPU:-}" | tr 'A-Z' 'a-z')" in
    1|true|yes) return 0 ;;
    0|false|no) return 1 ;;
  esac
  command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1
}

install_deps() {
  local name="$1"; local backend="$2"; shift 2
  local venv_path="${VENV_ROOT}/${name}"
  local venv_python="${venv_path}/bin/python"
  # The torch backend is chosen by the CALLER: "cpu" for the universal `pytorch`
  # venv (CPU wheels -> none of the CUDA build's ~3.5GB nvidia/triton dead weight),
  # "auto" for the `pytorch-gpu` venv (uv installs the matching CUDA build). Both
  # can coexist so the run-time client param picks one. An operator can still pin
  # via DSFLOWER_TORCH_BACKEND (e.g. cu126).
  local torch_flag=""
  case " $* " in *torch*)
    torch_flag="--torch-backend ${DSFLOWER_TORCH_BACKEND:-${backend}}"
    ;;
  esac
  if [ -n "${PYTHON_LOCK}" ]; then
    log_info "  ${name}: installing administrator hash-locked requirements"
  else
    log_info "  ${name}: installing $*"
  fi
  if [ "${USE_UV}" = true ]; then
    if [ -n "${PYTHON_LOCK}" ]; then
      # shellcheck disable=SC2086
      "${UV}" pip install --python "${venv_python}" --quiet ${torch_flag} \
        --require-hashes -r "${PYTHON_LOCK}" 2>&1 | tail -5
    else
      # shellcheck disable=SC2086
      "${UV}" pip install --python "${venv_python}" --quiet ${torch_flag} "$@" 2>&1 | tail -5
    fi
  else
    "${venv_path}/bin/pip" install --quiet --no-cache-dir "$@" 2>&1 | tail -5
  fi
}

mark_ready() {
  local venv_path="${VENV_ROOT}/$1"
  local versions_tmp="${venv_path}/.dsflower_versions.txt.tmp"
  if "${venv_path}/bin/python" - <<'PY' > "${versions_tmp}"
from importlib import metadata

rows = set()
for dist in metadata.distributions():
    name = dist.metadata.get("Name")
    if name and dist.version:
        rows.add(f"{name}=={dist.version}")
for row in sorted(rows, key=str.lower):
    print(row)
PY
  then
    mv "${versions_tmp}" "${venv_path}/.dsflower_versions.txt"
  else
    rm -f "${versions_tmp}"
    log_warn "  $1: could not record resolved dependency versions."
  fi
  printf '%s\n' "$2" > "${venv_path}/.dsflower_ready.tmp"
  mv "${venv_path}/.dsflower_ready.tmp" "${venv_path}/.dsflower_ready"
}

provision_framework() {
  local name="$1"; local backend="$2"; local check_modules="$3"; shift 3; local deps="$*"
  local venv_path="${VENV_ROOT}/${name}"
  local base_deps="flwr>=1.31.0,<1.32.0 numpy>=1.21.0 pandas>=1.3.0 pyarrow>=10.0.0 cryptography>=42.0.0"
  local expected_hash
  if [ -n "${PYTHON_LOCK}" ]; then
    expected_hash="python=${PYTHON_VERSION};lock-sha256:${PYTHON_LOCK_HASH}"
  else
    # shellcheck disable=SC2086
    expected_hash="$(deps_hash "python=${PYTHON_VERSION}" ${base_deps} ${deps})"
  fi

  if [ -f "${venv_path}/.dsflower_ready" ]; then
    current_hash="$(cat "${venv_path}/.dsflower_ready" 2>/dev/null || true)"
    # shellcheck disable=SC2086
    if [ "${current_hash}" = "${expected_hash}" ] && \
       check_imports "${venv_path}/bin/python" ${check_modules}; then
      log_info "  ${name}: OK (cached)"
      return 0
    fi
    log_info "  ${name}: cached but stale/unhealthy, refreshing..."
  fi

  # shellcheck disable=SC2086
  if check_imports "${PYTHON}" ${check_modules}; then
    log_info "  ${name}: system Python already has ${check_modules}, skipping venv."
    return 0
  fi

  if [ ! -x "${venv_path}/bin/python" ]; then
    create_venv "${name}" || { log_warn "  ${name}: venv failed."; return 0; }
  fi

  # shellcheck disable=SC2086
  install_deps "${name}" "${backend}" ${base_deps} ${deps} || {
    log_warn "  ${name}: install failed."; rm -rf "${venv_path}"; return 0
  }

  # shellcheck disable=SC2086
  if check_imports "${venv_path}/bin/python" ${check_modules}; then
    mark_ready "${name}" "${expected_hash}"
    log_info "  ${name}: ready."
  else
    log_warn "  ${name}: import check failed."; rm -rf "${venv_path}"
  fi
}

# ---------------------------------------------------------------------------
# Provision all frameworks
# ---------------------------------------------------------------------------

log_info "Provisioning Python environments for ML frameworks..."
echo ""

# ONE torch venv for BOTH tabular and vision (vision deps are a superset). The cpu
# and gpu venvs install the SAME packages; only --torch-backend differs.
PYTORCH_CHECK="flwr numpy pandas pyarrow cryptography torch opacus torchvision PIL nibabel pydicom nrrd SimpleITK monai"
PYTORCH_DEPS="torch>=2.0.0,<3.0.0 opacus>=1.4.0,<2.0.0 torchvision>=0.15.0,<1.0.0 Pillow>=9.0.0 nibabel>=5.0.0 pydicom>=2.4.0 pynrrd>=1.0.0 SimpleITK>=2.2.0 monai>=1.3.0"

# `pytorch` (cpu): the universal default -- built on every node, no CUDA dead weight.
# shellcheck disable=SC2086
provision_framework "pytorch" "cpu" "${PYTORCH_CHECK}" ${PYTORCH_DEPS}

# `pytorch-gpu` (cuda): built ONLY when a GPU is visible at (re)provision, so the
# backend is never locked in at first install. The run-time client param selects it;
# a GPU added later is picked up by a re-provision (this branch builds it then).
if gpu_present; then
  log_info "GPU visible -> also building the CUDA torch venv (pytorch-gpu)."
  # shellcheck disable=SC2086
  provision_framework "pytorch-gpu" "auto" "${PYTORCH_CHECK}" ${PYTORCH_DEPS}
fi

# Remove venvs from dropped frameworks so no obsolete venv lingers. Native tree
# learners are not exposed by this runner ABI; sklearn was replaced by the
# reviewed PyTorch/Opacus declarative path.
for _obsolete in xgboost sklearn; do
  if [ -d "${VENV_ROOT}/${_obsolete}" ]; then
    log_info "  removing obsolete venv: ${_obsolete}"
    rm -rf "${VENV_ROOT}/${_obsolete}"
  fi
done

# Fix Python permissions (Rock runs as non-root 'rock' user)
if [ -d "/root/.local/share/uv/python" ]; then
  chmod -R 755 /root/.local/share/uv/python/ 2>/dev/null
  chmod 755 /root /root/.local /root/.local/share /root/.local/share/uv 2>/dev/null
  log_info "Python permissions fixed for rock user"
fi

echo ""
log_info "Python environment setup complete."
log_info "Venvs stored in: ${VENV_ROOT}"

for fw in pytorch pytorch-gpu; do
  venv="${VENV_ROOT}/${fw}"
  if [ -f "${venv}/.dsflower_ready" ]; then
    size=$(du -sh "${venv}" 2>/dev/null | cut -f1)
    log_info "  ${fw}: ${size}"
  fi
done

# ---------------------------------------------------------------------------
# Ensure R dependencies are installed (Rock only)
# ---------------------------------------------------------------------------

ROCK_LIB="/var/lib/rock/R/library"
if [ -d "${ROCK_LIB}" ]; then
  log_info "Checking R dependencies..."
  for pkg in arrow digest jsonlite processx rappdirs yaml; do
    Rscript --vanilla -e "
      if (!requireNamespace('${pkg}', quietly=TRUE, lib.loc='${ROCK_LIB}')) {
        cat('Installing ${pkg}...\n')
        install.packages('${pkg}', lib='${ROCK_LIB}', repos='https://cloud.r-project.org', quiet=TRUE)
      }
    " 2>/dev/null
  done
  log_info "R dependencies OK"
fi

exit 0
