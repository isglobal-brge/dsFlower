# dsFlower VISION demo rock image
# ---------------------------------------------------------------------------
# = the dsflower-rock image (dsFlower + the full PyTorch vision venv already baked:
#   torch/torchvision/monai/SimpleITK/nibabel/pynrrd) PLUS dsImaging (+ dsHPC), so the
#   dsImaging image-resource path (imaging+dataset://...) resolves and federated VISION
#   models (pytorch_resnet18 / densenet121) train on medical images out of the box.
#
# Image reading for the FL path is done by the dsFlower venv; dsImaging is needed on the
# node only to RESOLVE the image resources. dsImaging's heavy analysis venvs (radiomics /
# TotalSegmentator) are intentionally NOT provisioned here (its configure is best-effort
# and finds no `uv` on the standard PATH), keeping this image light -- provision them
# separately on nodes that need dsImaging's own analysis runners.
#
# Build (after staging the tarballs here and publishing the reviewed base):
#   docker build -f docker/Dockerfile.vision \
#     --build-arg DSFLOWER_BASE_IMAGE='davidsarrat/dsflower-rock@sha256:<digest>' \
#     -t davidsarrat/dsflower-vision:0.4.3 docker/
# ---------------------------------------------------------------------------
# No mutable default: make the reviewed parent image an explicit build input.
ARG DSFLOWER_BASE_IMAGE
FROM ${DSFLOWER_BASE_IMAGE}

ARG DSFLOWER_BASE_IMAGE
ARG DSFLOWER_VERSION=0.4.3

LABEL org.opencontainers.image.title="dsflower-vision" \
      org.opencontainers.image.description="dsFlower vision FL node: dsflower-rock + dsImaging (+dsHPC) for federated medical-image models" \
      org.opencontainers.image.source="https://github.com/isglobal-brge/dsFlower" \
      org.opencontainers.image.version="${DSFLOWER_VERSION}" \
      org.opencontainers.image.base.name="${DSFLOWER_BASE_IMAGE}" \
      org.opencontainers.image.licenses="MIT"

COPY dsHPC.tar.gz dsImaging.tar.gz /tmp/

# R deps (skip any already in the base) + dsHPC + dsImaging, hand them to the rock user,
# and drop caches -- all in ONE layer. DBI/RSQLite belong to dsImaging's independent
# asset catalogue, not to dsFlower privacy state. dsImaging's configure is best-effort
# and, finding no `uv` on the standard PATH, skips its heavy analysis venvs.
RUN R -e 'p<-c("DBI","RSQLite","filelock","arrow","uuid","yaml","aws.s3","resourcer","R6","digest","jsonlite","processx"); m<-p[!vapply(p,requireNamespace,logical(1),quietly=TRUE)]; if(length(m)) install.packages(m, repos="https://cloud.r-project.org")' \
 && R CMD INSTALL --library=/var/lib/rock/R/library /tmp/dsHPC.tar.gz \
 && R CMD INSTALL --library=/var/lib/rock/R/library /tmp/dsImaging.tar.gz \
 && (chown -R rock:rock /var/lib/rock/R/library/dsImaging /var/lib/rock/R/library/dsHPC /var/lib/dsimaging 2>/dev/null || true) \
 && rm -rf /tmp/dsHPC.tar.gz /tmp/dsImaging.tar.gz /var/lib/rock/.cache/uv /root/.cache/uv \
 && test ! -e "${DSFLOWER_NODE_SECRET_FILE:-/var/lib/dsflower/privacy/noise_root}" \
 && test ! -L "${DSFLOWER_NODE_SECRET_FILE:-/var/lib/dsflower/privacy/noise_root}" \
 && test ! -e /var/lib/dsflower/privacy/noise_root \
 && test ! -L /var/lib/dsflower/privacy/noise_root \
 && test ! -e /var/lib/dsflower/node_secret \
 && test ! -L /var/lib/dsflower/node_secret \
 && R -e '.libPaths(c("/var/lib/rock/R/library", .libPaths())); p<-c(Sys.getenv("DSFLOWER_NODE_SECRET_FILE",unset=""),dsFlower:::.dsf_option("node_secret_path",""),"/var/lib/dsflower/privacy/noise_root"); p<-as.character(p); p<-p[!is.na(p)&nzchar(p)]; if(any(file.exists(p)|vapply(p,dsFlower:::.path_is_symlink,logical(1)))) stop("noise root was created during image build")'

# ENTRYPOINT / CMD / port inherited from dsflower-rock (-> datashield/rock-base).
