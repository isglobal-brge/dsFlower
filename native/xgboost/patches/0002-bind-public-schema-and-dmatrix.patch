+bool ValidateDMatrix(std::shared_ptr<DMatrix> const& dmatrix, PrivacyContext const& context,
+                     std::string* error) {
+  if (!dmatrix || dynamic_cast<data::SimpleDMatrix*>(dmatrix.get()) == nullptr) {
+    return Reject("dsFlower requires an in-memory SimpleDMatrix", error);
+  }
+  if (dmatrix->Ctx() == nullptr || !dmatrix->Ctx()->IsCPU()) {
+    return Reject("dsFlower requires a CPU DMatrix", error);
+  }
+  auto const& info = dmatrix->Info();
+  if (info.num_row_ == 0 || info.num_col_ != context.feature_lower_bounds.size()) {
+    return Reject("dsFlower DMatrix dimensions do not match the public feature schema", error);
+  }
+  if (info.labels.Shape(0) != info.num_row_ || info.labels.Shape(1) != 1) {
+    return Reject("dsFlower requires exactly one label per DMatrix row", error);
+  }
+  auto feature_types = info.feature_types.ConstHostSpan();
+  if ((!feature_types.empty() && feature_types.size() != info.num_col_) ||
+      std::any_of(feature_types.cbegin(), feature_types.cend(),
+                  [](FeatureType type) { return type != FeatureType::kNumerical; })) {
+    return Reject("dsFlower requires numeric, non-categorical features", error);
+  }
+  if (!info.group_ptr_.empty() || !info.weights_.Empty() || !info.feature_weights.Empty() ||
+      !info.base_margin_.Empty() || !info.labels_lower_bound_.Empty() ||
+      !info.labels_upper_bound_.Empty()) {
+    return Reject(
+        "dsFlower does not accept ranking groups, row/feature weights, base margins, or survival "
+        "bounds",
+        error);
+  }
+  auto labels = info.labels.Data()->ConstHostSpan();
+  bool is_binary = context.task_id == "binary_classification";
+  for (float label : labels) {
+    if (!std::isfinite(label) || label < context.target_lower_bound ||
+        label > context.target_upper_bound || (is_binary && label != 0.0f && label != 1.0f)) {
+      return Reject("dsFlower labels do not satisfy the server-owned task and target bounds",
+                    error);
+    }
+  }
+  if (!context.sealed_labels.empty() &&
+      (labels.size() != context.sealed_labels.size() ||
+       !std::equal(labels.cbegin(), labels.cend(), context.sealed_labels.cbegin()))) {
+    return Reject("dsFlower labels changed after privacy context binding", error);
+  }
+  return true;
