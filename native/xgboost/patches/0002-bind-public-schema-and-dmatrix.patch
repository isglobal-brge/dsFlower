+bool CopyPublicSchema(const XGBDsFlowerPrivacyContext& input, PrivacyContext* next,
+                      std::string* error) {
+  if (input.feature_lower_bounds == nullptr || input.feature_upper_bounds == nullptr ||
+      input.feature_lower_bounds_size == 0 ||
+      input.feature_lower_bounds_size != input.feature_upper_bounds_size ||
+      input.feature_lower_bounds_size > kMaxFeatures) {
+    return Reject("dsFlower feature bounds must contain one to 8192 matched features", error);
+  }
+  auto n_features = input.feature_lower_bounds_size;
+  if (input.cut_ptrs == nullptr || input.cut_ptrs_size != n_features + 1) {
+    return Reject("dsFlower cut_ptrs must contain exactly feature_count + 1 entries", error);
+  }
+  if (input.cut_values_size == 0 || input.cut_values_size > kMaxTotalCuts ||
+      input.cut_values == nullptr) {
+    return Reject("dsFlower public cuts must contain one to 16384 values", error);
+  }
+
+  std::vector<double> lower(input.feature_lower_bounds,
+                            input.feature_lower_bounds + n_features);
+  std::vector<double> upper(input.feature_upper_bounds,
+                            input.feature_upper_bounds + n_features);
+  std::vector<std::uint64_t> cut_ptrs(input.cut_ptrs, input.cut_ptrs + input.cut_ptrs_size);
+  std::vector<double> cuts(input.cut_values, input.cut_values + input.cut_values_size);
+
+  if (cut_ptrs.front() != 0 || cut_ptrs.back() != cuts.size()) {
+    return Reject("dsFlower cut_ptrs must start at zero and end at cut_values_size", error);
+  }
+  for (std::size_t i = 0; i < n_features; ++i) {
+    if (cut_ptrs[i] > cut_ptrs[i + 1] || cut_ptrs[i + 1] > cuts.size()) {
+      return Reject("dsFlower cut_ptrs must be monotone and in range", error);
+    }
+  }
+
+  next->feature_lower_bounds.resize(n_features);
+  next->feature_upper_bounds.resize(n_features);
+  next->cut_values.resize(cuts.size());
+  next->cut_ptrs = std::move(cut_ptrs);
+  for (std::size_t i = 0; i < n_features; ++i) {
+    float lo{0.0f};
+    float hi{0.0f};
+    if (!ToFiniteFloat(lower[i], &lo) || !ToFiniteFloat(upper[i], &hi) || !(lo < hi)) {
+      return Reject("dsFlower feature bounds must remain finite and strict after float conversion",
+                    error);
+    }
+    next->feature_lower_bounds[i] = lo;
+    next->feature_upper_bounds[i] = hi;
+
+    auto begin = next->cut_ptrs[i];
+    auto end = next->cut_ptrs[i + 1];
+    float previous = lo;
+    for (auto j = begin; j < end; ++j) {
+      float cut{0.0f};
+      if (!ToFiniteFloat(cuts[j], &cut) || !(lo < cut && cut < hi) || !(previous < cut)) {
+        return Reject(
+            "dsFlower cuts must remain finite, strict, increasing and inside bounds after float "
+            "conversion",
+            error);
+      }
+      next->cut_values[j] = cut;
+      previous = cut;
+    }
+  }
+  return true;
+}
+
+bool ValidateTask(const XGBDsFlowerPrivacyContext& input, PrivacyContext* next,
+                  std::string* error) {
+  if (input.task_id == nullptr || input.objective == nullptr) {
+    return Reject("dsFlower task_id and objective are required", error);
+  }
+  std::string_view task{input.task_id};
+  std::string_view objective{input.objective};
+  bool is_binary = task == "binary_classification";
+  bool is_regression = task == "regression";
+  if ((!is_binary && !is_regression) ||
+      (is_binary && objective != "binary:logistic") ||
+      (is_regression && objective != "reg:squarederror")) {
+    return Reject(
+        "dsFlower supports only binary_classification/binary:logistic or "
+        "regression/reg:squarederror",
+        error);
+  }
+  if (!std::isfinite(input.target_lower_bound) ||
+      !std::isfinite(input.target_upper_bound) ||
+      !(input.target_lower_bound < input.target_upper_bound)) {
+    return Reject("dsFlower public target bounds must be finite and strict", error);
+  }
+  if (is_binary &&
+      (input.target_lower_bound != 0.0 || input.target_upper_bound != 1.0)) {
+    return Reject("dsFlower binary target bounds must equal zero and one", error);
+  }
+  if (!std::isfinite(input.base_score) ||
+      input.base_score < input.target_lower_bound ||
+      input.base_score > input.target_upper_bound ||
+      (is_binary && (input.base_score <= 0.0 || input.base_score >= 1.0))) {
+    return Reject("dsFlower public base_score must lie inside the target bounds", error);
+  }
+  float target_lower{0.0f};
+  float target_upper{0.0f};
+  float base_score{0.0f};
+  if (!ToFiniteFloat(input.target_lower_bound, &target_lower) ||
+      !ToFiniteFloat(input.target_upper_bound, &target_upper) ||
+      !(target_lower < target_upper) || !ToFiniteFloat(input.base_score, &base_score) ||
+      base_score < target_lower || base_score > target_upper ||
+      (is_binary && (base_score <= 0.0f || base_score >= 1.0f))) {
+    return Reject("dsFlower target bounds and base_score must be representable as finite floats",
+                  error);
+  }
+  next->task_id = input.task_id;
+  next->objective = input.objective;
+  next->target_lower_bound = target_lower;
+  next->target_upper_bound = target_upper;
+  next->base_score = base_score;
+  return true;
+}
