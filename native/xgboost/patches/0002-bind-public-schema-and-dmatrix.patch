+  next->feature_lower_bounds.resize(n_features);
+  next->feature_upper_bounds.resize(n_features);
+  next->cut_values.resize(cuts.size());
+  next->cut_ptrs = std::move(cut_ptrs);
+  for (std::size_t i = 0; i < n_features; ++i) {
+    float lo{0.0f};
+    float hi{0.0f};
+    if (!ToFiniteFloat(lower[i], &lo) || !ToFiniteFloat(upper[i], &hi) || !(lo < hi)) {
+      return Reject("dsFlower feature bounds must remain finite and strict after float conversion",
