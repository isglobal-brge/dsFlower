+bool TryValidateUpdaterConfiguration(Args const& args, ObjInfo const* task,
+                                     std::uint64_t* out_generation, std::string* error) {
+  if (!g_context.ready) {
+    return Reject("dsFlower updater requires an installed privacy context", error);
+  }
+  if (task == nullptr) {
+    return Reject("dsFlower updater requires an inspectable objective task", error);
+  }
+  if (out_generation == nullptr) {
+    return Reject("dsFlower updater generation output is required", error);
+  }
+  auto expected_task = g_context.value.task_id == "binary_classification" ? ObjInfo::kBinary
+                                                                          : ObjInfo::kRegression;
+  if (task->task != expected_task) {
+    return Reject("dsFlower XGBoost objective task does not match the privacy context", error);
+  }
+  std::string objective;
+  if (!FindArgument(args, "objective", &objective) || objective != g_context.value.objective) {
+    return Reject("dsFlower XGBoost objective must be explicitly server-pinned", error);
+  }
+  std::string base_score_text;
+  double base_score{0.0};
+  if (!FindArgument(args, "base_score", &base_score_text) ||
+      !ParseFiniteDouble(base_score_text, &base_score) ||
+      static_cast<float>(base_score) != static_cast<float>(g_context.value.base_score)) {
+    return Reject("dsFlower XGBoost base_score must be explicitly server-pinned", error);
+  }
+  std::string value;
+  if (FindArgument(args, "boost_from_average", &value) && value != "0" && value != "false") {
+    return Reject("dsFlower XGBoost boost_from_average must remain disabled", error);
+  }
+  if (!FindArgument(args, "updater", &value) || value != "grow_dsflower_dp_hist") {
+    return Reject("dsFlower XGBoost requires the exclusive trusted updater", error);
+  }
+  for (auto const& pin : {std::pair<std::string_view, std::uint64_t>{"num_class", 0},
+                          {"num_target", 1}, {"num_parallel_tree", 1}}) {
+    std::uint64_t parsed{0};
+    if (FindArgument(args, pin.first, &value) &&
+        (!ParseUnsigned(value, &parsed) || parsed != pin.second)) {
+      return Reject("dsFlower XGBoost requires a single-output, one-tree execution shape", error);
+    }
+  }
+  if (FindArgument(args, "multi_strategy", &value) && value != "one_output_per_tree") {
+    return Reject("dsFlower XGBoost requires one_output_per_tree", error);
+  }
+  if (FindArgument(args, "process_type", &value) && value != "default") {
+    return Reject("dsFlower XGBoost does not update pre-existing trees", error);
+  }
+  if (FindArgument(args, "device", &value) && value != "cpu") {
+    return Reject("dsFlower XGBoost requires CPU execution", error);
+  }
+  *out_generation = g_context.value.generation;
+  return true;
+}
