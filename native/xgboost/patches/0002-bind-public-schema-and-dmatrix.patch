+    return Reject("dsFlower public base_score must lie inside the target bounds", error);
+  }
+  float target_lower{0.0f};
+  float target_upper{0.0f};
+  float base_score{0.0f};
+  if (!ToFiniteFloat(input.target_lower_bound, &target_lower) ||
+      !ToFiniteFloat(input.target_upper_bound, &target_upper) ||
+      !(target_lower < target_upper) || !ToFiniteFloat(input.base_score, &base_score) ||
+      base_score < target_lower || base_score > target_upper ||
+      (is_binary && (base_score <= 0.0f || base_score >= 1.0f))) {
+    return Reject("dsFlower target bounds and base_score must be representable as finite floats",
+                  error);
+  }
+  next->task_id = input.task_id;
+  next->objective = input.objective;
+  next->target_lower_bound = target_lower;
+  next->target_upper_bound = target_upper;
