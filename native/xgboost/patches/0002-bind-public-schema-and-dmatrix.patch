+bool ParseFiniteDouble(std::string const& text, double* out) {
+  errno = 0;
+  char* end{nullptr};
+  auto value = std::strtod(text.c_str(), &end);
+  if (errno != 0 || end == text.c_str() || end == nullptr || *end != '\0' ||
+      !std::isfinite(value)) {
+    return false;
+  }
+  *out = value;
+  return true;
+}
+
+bool ParseUnsigned(std::string const& text, std::uint64_t* out) {
+  if (text.empty() || text.front() < '0' || text.front() > '9') {
+    return false;
+  }
+  errno = 0;
+  char* end{nullptr};
+  auto value = std::strtoull(text.c_str(), &end, 10);
+  if (errno != 0 || end == text.c_str() || end == nullptr || *end != '\0') {
+    return false;
+  }
+  *out = value;
+  return true;
+}
