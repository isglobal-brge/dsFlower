+  }
+  if (!std::isfinite(input.target_lower_bound) ||
+      !std::isfinite(input.target_upper_bound) ||
+      !(input.target_lower_bound < input.target_upper_bound)) {
+    return Reject("dsFlower public target bounds must be finite and strict", error);
