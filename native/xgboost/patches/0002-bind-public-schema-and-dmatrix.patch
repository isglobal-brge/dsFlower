+  }
+  if (input.cut_values_size == 0 || input.cut_values_size > kMaxTotalCuts ||
+      input.cut_values == nullptr) {
+    return Reject("dsFlower public cuts must contain one to 16384 values", error);
+  }
+
+  std::vector<double> lower(input.feature_lower_bounds,
