+
+void BuildFixedPointDpTree(Context const* runtime, TrainParam const& train,
+                           GradientContainer* gradients, DMatrix* dmatrix,
+                           PrivacyContext const& privacy,
+                           std::uint64_t tree_index,
+                           HostDeviceVector<bst_node_t>* out_position, RegTree* out_tree) {
+  CHECK(runtime != nullptr && runtime->IsCPU());
+  CHECK(gradients != nullptr && dmatrix != nullptr && out_position != nullptr &&
+        out_tree != nullptr);
+  CHECK_EQ(gradients->NumSplitTargets(), 1);
+  CHECK(!gradients->HasValueGrad());
+
+  PublicHistogramSchema schema{privacy};
+  auto const rows = static_cast<std::size_t>(dmatrix->Info().num_row_);
+  CHECK_LT(tree_index, privacy.max_trees);
+  ValidateTraining(train, privacy, rows, schema);
+
+  auto batches = dmatrix->GetBatches<SparsePage>(runtime);
+  auto iterator = batches.begin();
+  CHECK(iterator != batches.end());
+  auto const& page = *iterator;
+  ++iterator;
+  CHECK(iterator.AtEnd());
+  CHECK_EQ(page.base_rowid, 0);
+  auto view = page.GetView();
+  auto gradient_view = gradients->Grad()->HostView().Slice(linalg::All(), 0).Values();
+  CHECK_EQ(gradient_view.size(), rows);
+
+  RegTree planned{1, static_cast<bst_feature_t>(schema.Features())};
+  std::vector<bst_node_t> row_nodes(rows, RegTree::kRoot);
+  std::vector<ActiveNode> active{{RegTree::kRoot, {}}};
+
+  for (std::uint64_t depth = 0; depth < privacy.max_depth && !active.empty(); ++depth) {
+    std::vector<bst_node_t> active_ids;
+    active_ids.reserve(active.size());
+    for (auto const& node : active) {
+      active_ids.push_back(node.node);
+    }
+    auto raw = BuildRawLevel(view, gradient_view, row_nodes, active_ids, schema, privacy,
+                             privacy.fixed_point_scale);
+    auto level = PrivatizeLevel(std::move(raw), depth == 0,
+                                depth == 0 ? privacy.root_noise_scale : privacy.level_noise_scale,
+                                privacy, privacy.fixed_point_scale, tree_index,
+                                static_cast<std::uint32_t>(depth));
+    if (depth == 0) {
+      active.front().total = level.RootTotal();
+    }
+
+    std::vector<ActiveNode> next_active;
+    std::vector<SplitCandidate> selected(active.size());
+    for (std::size_t i = 0; i < active.size(); ++i) {
+      ProjectHessians(&level, i, schema, active[i].total.hessian);
+      auto weight = NodeWeight(train, active[i].total);
+      planned[active[i].node].SetLeaf(FiniteFloat(train.learning_rate * weight));
+      planned.Stat(active[i].node).base_weight = FiniteFloat(weight);
+      planned.Stat(active[i].node).sum_hess = FiniteFloat(active[i].total.hessian);
+      auto best = BestSplit(train, level, i, schema, active[i].total);
+      if (!best.valid || best.gain <= static_cast<double>(train.min_split_loss)) {
+        continue;
+      }
+      auto left_weight = NodeWeight(train, best.left);
+      auto right_weight = NodeWeight(train, best.right);
+      auto split_value = schema.SplitValue(best.feature, best.cut);
+      planned.ExpandNode(active[i].node, static_cast<unsigned>(best.feature), split_value,
+                         best.default_left, FiniteFloat(weight),
+                         FiniteFloat(train.learning_rate * left_weight),
+                         FiniteFloat(train.learning_rate * right_weight), FiniteFloat(best.gain),
+                         FiniteFloat(active[i].total.hessian), FiniteFloat(best.left.hessian),
+                         FiniteFloat(best.right.hessian));
+      selected[i] = best;
+      auto const& expanded = planned[active[i].node];
+      next_active.push_back({expanded.LeftChild(), best.left});
+      next_active.push_back({expanded.RightChild(), best.right});
+    }
+
+    if (!next_active.empty()) {
+      std::vector<std::int64_t> active_index(static_cast<std::size_t>(planned.NumNodes()), -1);
+      for (std::size_t i = 0; i < active.size(); ++i) {
+        active_index.at(static_cast<std::size_t>(active[i].node)) = static_cast<std::int64_t>(i);
+      }
+      for (std::size_t row = 0; row < rows; ++row) {
+        auto node = row_nodes[row];
+        if (node < 0 || static_cast<std::size_t>(node) >= active_index.size()) {
+          continue;
+        }
+        auto slot = active_index[static_cast<std::size_t>(node)];
+        if (slot < 0 || !selected[static_cast<std::size_t>(slot)].valid) {
+          continue;
+        }
+        auto const& split = selected[static_cast<std::size_t>(slot)];
+        bool missing{true};
+        float value{0.0f};
+        for (auto const& entry : view[row]) {
+          if (entry.index == split.feature && !std::isnan(entry.fvalue)) {
+            missing = false;
+            value = entry.fvalue;
+          }
+        }
+        auto const& tree_node = planned[node];
+        bool go_left = missing ? split.default_left : value < tree_node.SplitCond();
+        row_nodes[row] = go_left ? tree_node.LeftChild() : tree_node.RightChild();
+      }
+    }
+    active = std::move(next_active);
+  }
+
+  Json serialized{Object{}};
+  planned.SaveModel(&serialized);
+  out_tree->LoadModel(serialized);
+  auto& positions = out_position->HostVector();
+  positions.assign(row_nodes.cbegin(), row_nodes.cend());
+}
