new file mode 100644
index 0000000000000000000000000000000000000000..1369f675cf1d858147191e8fe27383046fb7bb66
--- /dev/null
+++ b/plugin/dsflower/dsflower_dp_hist.cc
@@ -0,0 +1,676 @@
+/**
+ * Copyright 2026 Barcelona Institute for Global Health (ISGlobal)
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#include "dsflower_dp_hist.h"
+
+#include <dsflower_dp_primitives.h>
+#include <xgboost/json.h>
+#include <xgboost/logging.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <limits>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace xgboost::tree::dsflower {
+namespace {
+
+constexpr char kReleaseDomainLabel[] = "dsflower/xgboost/dp-hist/release/v1";
+constexpr char kExpectedPrimitiveMechanism[] =
+    "cks20-discrete-gaussian-i64-hmac-sha256-v1";
+constexpr std::uint8_t kJointHistogramRelease = 1;
+
+static_assert(DSFLOWER_DP_PRIMITIVES_ABI_VERSION == 2U,
+              "dsFlower XGBoost requires deterministic DP primitives ABI v2");
+
+std::vector<std::uint8_t> MakeReleaseDomain(std::uint64_t tree_index, std::uint32_t depth) {
+  std::vector<std::uint8_t> domain;
+  domain.reserve(sizeof(kReleaseDomainLabel) + sizeof(tree_index) + sizeof(depth) + 1);
+  for (char value : kReleaseDomainLabel) {
+    domain.push_back(static_cast<std::uint8_t>(value));
+  }
+  domain.push_back(kJointHistogramRelease);
+  for (int shift = 56; shift >= 0; shift -= 8) {
+    domain.push_back(static_cast<std::uint8_t>(tree_index >> shift));
+  }
+  for (int shift = 24; shift >= 0; shift -= 8) {
+    domain.push_back(static_cast<std::uint8_t>(depth >> shift));
+  }
+  return domain;
+}
+
+std::size_t CheckedAddSize(std::size_t left, std::size_t right) {
+  CHECK_LE(right, std::numeric_limits<std::size_t>::max() - left)
+      << "dsFlower public histogram geometry overflows size_t";
+  return left + right;
+}
+
+std::size_t CheckedMultiplySize(std::size_t left, std::size_t right) {
+  if (left == 0 || right == 0) {
+    return 0;
+  }
+  CHECK_LE(left, std::numeric_limits<std::size_t>::max() / right)
+      << "dsFlower public histogram geometry overflows size_t";
+  return left * right;
+}
+
+std::int64_t CheckedAdd(std::int64_t left, std::int64_t right) {
+  if (right > 0) {
+    CHECK_LE(left, std::numeric_limits<std::int64_t>::max() - right)
+        << "dsFlower fixed-point accumulator overflow";
+  } else if (right < 0) {
+    CHECK_GE(left, std::numeric_limits<std::int64_t>::min() - right)
+        << "dsFlower fixed-point accumulator overflow";
+  }
+  return left + right;
+}
+
+std::int64_t CheckedSubtract(std::int64_t left, std::int64_t right) {
+  if (right > 0) {
+    CHECK_GE(left, std::numeric_limits<std::int64_t>::min() + right)
+        << "dsFlower fixed-point accumulator overflow";
+  } else if (right < 0) {
+    CHECK_LE(left, std::numeric_limits<std::int64_t>::max() + right)
+        << "dsFlower fixed-point accumulator overflow";
+  }
+  return left - right;
+}
+
+void SecureZero(std::int64_t* values, std::size_t size) {
+  volatile std::int64_t* out = values;
+  for (std::size_t i = 0; i < size; ++i) {
+    out[i] = 0;
+  }
+}
+
+struct IntegerStatistic {
+  std::int64_t gradient{0};
+  std::int64_t hessian{0};
+
+  void Add(IntegerStatistic const& other) {
+    gradient = CheckedAdd(gradient, other.gradient);
+    hessian = CheckedAdd(hessian, other.hessian);
+  }
+};
+
+static_assert(sizeof(IntegerStatistic) == 2 * sizeof(std::int64_t));
+
+class PublicHistogramSchema {
+ public:
+  explicit PublicHistogramSchema(PrivacyContext const& context)
+      : cut_ptrs_{context.cut_ptrs}, cuts_{context.cut_values} {
+    offsets_.reserve(this->Features() + 1);
+    offsets_.push_back(0);
+    for (std::size_t feature = 0; feature < this->Features(); ++feature) {
+      auto cuts = this->CutCount(feature);
+      offsets_.push_back(CheckedAddSize(offsets_.back(), CheckedAddSize(cuts, 2)));
+    }
+  }
+
+  [[nodiscard]] std::size_t Features() const { return cut_ptrs_.size() - 1; }
+  [[nodiscard]] std::size_t TotalBins() const { return offsets_.back(); }
+  [[nodiscard]] std::size_t CutCount(std::size_t feature) const {
+    return static_cast<std::size_t>(cut_ptrs_.at(feature + 1) - cut_ptrs_.at(feature));
+  }
+  [[nodiscard]] std::size_t FeatureOffset(std::size_t feature) const {
+    return offsets_.at(feature);
+  }
+  [[nodiscard]] std::size_t MissingBin(std::size_t feature) const {
+    return this->FeatureOffset(feature) + this->CutCount(feature) + 1;
+  }
+  [[nodiscard]] std::size_t PresentBin(std::size_t feature, float value) const {
+    auto first = cuts_.cbegin() + static_cast<std::ptrdiff_t>(cut_ptrs_.at(feature));
+    auto last = cuts_.cbegin() + static_cast<std::ptrdiff_t>(cut_ptrs_.at(feature + 1));
+    auto local = static_cast<std::size_t>(std::lower_bound(first, last, value) - first);
+    return this->FeatureOffset(feature) + local;
+  }
+  [[nodiscard]] float SplitValue(std::size_t feature, std::size_t cut) const {
+    auto value = cuts_.at(static_cast<std::size_t>(cut_ptrs_.at(feature)) + cut);
+    auto split = std::nextafter(value, std::numeric_limits<float>::infinity());
+    CHECK(std::isfinite(split)) << "dsFlower public split cannot be represented as a float";
+    return split;
+  }
+
+ private:
+  std::vector<std::uint64_t> cut_ptrs_;
+  std::vector<float> cuts_;
+  std::vector<std::size_t> offsets_;
+};
+
+std::int64_t QuantizeSigned(float value, double clip, std::uint64_t scale) {
+  double bounded{0.0};
+  if (std::isnan(value)) {
+    bounded = 0.0;
+  } else if (std::isinf(value)) {
+    bounded = std::signbit(value) ? -clip : clip;
+  } else {
+    bounded = std::max(-clip, std::min(clip, static_cast<double>(value)));
+  }
+  volatile double normalized = bounded / clip;
+  volatile double scaled = normalized * static_cast<double>(scale);
+  auto magnitude = std::floor(std::abs(static_cast<double>(scaled)) + 0.5);
+  auto quantized = std::copysign(magnitude, static_cast<double>(scaled));
+  CHECK_LE(std::abs(quantized), static_cast<double>(scale));
+  return static_cast<std::int64_t>(quantized);
+}
+
+std::int64_t QuantizeNonnegative(float value, double clip, std::uint64_t scale) {
+  double bounded{0.0};
+  if (std::isnan(value) || value <= 0.0f) {
+    bounded = 0.0;
+  } else if (std::isinf(value)) {
+    bounded = clip;
+  } else {
+    bounded = std::min(clip, static_cast<double>(value));
+  }
+  volatile double normalized = bounded / clip;
+  volatile double scaled = normalized * static_cast<double>(scale);
+  auto quantized = std::floor(static_cast<double>(scaled) + 0.5);
+  CHECK_GE(quantized, 0.0);
+  CHECK_LE(quantized, static_cast<double>(scale));
+  return static_cast<std::int64_t>(quantized);
+}
+
+IntegerStatistic QuantizeGradient(GradientPair const& pair, PrivacyContext const& privacy,
+                                  std::uint64_t scale) {
+  IntegerStatistic out;
+  out.gradient = QuantizeSigned(pair.GetGrad(), privacy.gradient_clip, scale);
+  if (privacy.task_id == "regression") {
+    out.hessian = static_cast<std::int64_t>(scale);
+  } else {
+    out.hessian = QuantizeNonnegative(pair.GetHess(), privacy.hessian_clip, scale);
+  }
+  return out;
+}
+
+class PrivateLevelHistogram;
+
+class RawLevelHistogram {
+ public:
+  RawLevelHistogram(std::size_t nodes, std::size_t bins)
+      : totals_(nodes), cells_(CheckedMultiplySize(nodes, bins)), bins_{bins} {}
+  RawLevelHistogram(RawLevelHistogram const&) = delete;
+  RawLevelHistogram& operator=(RawLevelHistogram const&) = delete;
+  RawLevelHistogram(RawLevelHistogram&&) noexcept = default;
+  RawLevelHistogram& operator=(RawLevelHistogram&&) noexcept = default;
+  ~RawLevelHistogram() {
+    for (auto& value : totals_) {
+      SecureZero(&value.gradient, 1);
+      SecureZero(&value.hessian, 1);
+    }
+    for (auto& value : cells_) {
+      SecureZero(&value.gradient, 1);
+      SecureZero(&value.hessian, 1);
+    }
+  }
+
+ private:
+  [[nodiscard]] IntegerStatistic& Total(std::size_t node) { return totals_.at(node); }
+  [[nodiscard]] IntegerStatistic& Cell(std::size_t node, std::size_t bin) {
+    return cells_.at(CheckedAddSize(CheckedMultiplySize(node, bins_), bin));
+  }
+
+  std::vector<IntegerStatistic> totals_;
+  std::vector<IntegerStatistic> cells_;
+  std::size_t bins_{0};
+
+  friend class PrivateLevelHistogram;
+  friend PrivateLevelHistogram PrivatizeLevel(RawLevelHistogram&&, bool, std::uint64_t,
+                                              PrivacyContext const&, std::uint64_t,
+                                              std::uint64_t, std::uint32_t);
+  friend RawLevelHistogram BuildRawLevel(HostSparsePageView, common::Span<GradientPair const>,
+                                         std::vector<bst_node_t> const&,
+                                         std::vector<bst_node_t> const&,
+                                         PublicHistogramSchema const&, PrivacyContext const&,
+                                         std::uint64_t);
+};
+
+struct PrivateStatistic {
+  double gradient{0.0};
+  double hessian{0.0};
+
+  void Add(PrivateStatistic const& other) {
+    gradient += other.gradient;
+    hessian += other.hessian;
+  }
+};
+
+class PrivateLevelHistogram {
+ public:
+  [[nodiscard]] PrivateStatistic const& RootTotal() const {
+    CHECK(has_root_total_);
+    return root_total_;
+  }
+  [[nodiscard]] PrivateStatistic const& Cell(std::size_t node, std::size_t bin) const {
+    return cells_.at(CheckedAddSize(CheckedMultiplySize(node, bins_), bin));
+  }
+  [[nodiscard]] PrivateStatistic& Cell(std::size_t node, std::size_t bin) {
+    return cells_.at(CheckedAddSize(CheckedMultiplySize(node, bins_), bin));
+  }
+
+ private:
+  bool has_root_total_{false};
+  PrivateStatistic root_total_;
+  std::vector<PrivateStatistic> cells_;
+  std::size_t bins_{0};
+
+  friend PrivateLevelHistogram PrivatizeLevel(RawLevelHistogram&&, bool, std::uint64_t,
+                                              PrivacyContext const&, std::uint64_t,
+                                              std::uint64_t, std::uint32_t);
+};
+
+RawLevelHistogram BuildRawLevel(HostSparsePageView page, common::Span<GradientPair const> gradients,
+                                std::vector<bst_node_t> const& row_nodes,
+                                std::vector<bst_node_t> const& active_nodes,
+                                PublicHistogramSchema const& schema, PrivacyContext const& privacy,
+                                std::uint64_t scale) {
+  CHECK_EQ(page.Size(), gradients.size());
+  CHECK_EQ(page.Size(), row_nodes.size());
+
+  std::vector<std::int64_t> active_index;
+  auto max_node = active_nodes.empty()
+                      ? bst_node_t{0}
+                      : *std::max_element(active_nodes.cbegin(), active_nodes.cend());
+  active_index.resize(static_cast<std::size_t>(max_node) + 1, -1);
+  for (std::size_t i = 0; i < active_nodes.size(); ++i) {
+    CHECK_GE(active_nodes[i], 0);
+    active_index.at(static_cast<std::size_t>(active_nodes[i])) = static_cast<std::int64_t>(i);
+  }
+
+  RawLevelHistogram raw{active_nodes.size(), schema.TotalBins()};
+  auto const unseen = std::numeric_limits<std::size_t>::max();
+  std::vector<std::size_t> selected_bins(schema.Features(), unseen);
+  std::vector<std::size_t> touched_features;
+  touched_features.reserve(schema.Features());
+  for (std::size_t row = 0; row < page.Size(); ++row) {
+    auto node = row_nodes[row];
+    if (node < 0 || static_cast<std::size_t>(node) >= active_index.size() ||
+        active_index[static_cast<std::size_t>(node)] < 0) {
+      continue;
+    }
+    auto slot = static_cast<std::size_t>(active_index[static_cast<std::size_t>(node)]);
+    auto statistic = QuantizeGradient(gradients[row], privacy, scale);
+    raw.Total(slot).Add(statistic);
+
+    touched_features.clear();
+    for (auto const& entry : page[row]) {
+      auto feature = static_cast<std::size_t>(entry.index);
+      if (feature >= schema.Features() || std::isnan(entry.fvalue)) {
+        continue;
+      }
+      if (selected_bins[feature] == unseen) {
+        touched_features.push_back(feature);
+      }
+      selected_bins[feature] = schema.PresentBin(feature, entry.fvalue);
+    }
+    for (auto feature : touched_features) {
+      raw.Cell(slot, selected_bins[feature]).Add(statistic);
+      selected_bins[feature] = unseen;
+    }
+  }
+
+  for (std::size_t node = 0; node < active_nodes.size(); ++node) {
+    for (std::size_t feature = 0; feature < schema.Features(); ++feature) {
+      IntegerStatistic observed;
+      auto begin = schema.FeatureOffset(feature);
+      auto present_end = schema.MissingBin(feature);
+      for (auto bin = begin; bin < present_end; ++bin) {
+        observed.Add(raw.Cell(node, bin));
+      }
+      auto& missing = raw.Cell(node, schema.MissingBin(feature));
+      missing.gradient = CheckedSubtract(raw.Total(node).gradient, observed.gradient);
+      missing.hessian = CheckedSubtract(raw.Total(node).hessian, observed.hessian);
+    }
+  }
+  return raw;
+}
+
+PrivateStatistic Decode(IntegerStatistic const& value, PrivacyContext const& privacy,
+                        std::uint64_t fixed_point_scale) {
+  auto denominator = static_cast<double>(fixed_point_scale);
+  PrivateStatistic out;
+  out.gradient = static_cast<double>(value.gradient) / denominator * privacy.gradient_clip;
+  auto hessian_clip = privacy.task_id == "regression" ? 1.0 : privacy.hessian_clip;
+  out.hessian = std::max(0.0, static_cast<double>(value.hessian) / denominator * hessian_clip);
+  CHECK(std::isfinite(out.gradient) && std::isfinite(out.hessian))
+      << "dsFlower privatized statistics must remain finite";
+  return out;
+}
+
+PrivateLevelHistogram PrivatizeLevel(RawLevelHistogram&& raw, bool include_root_total,
+                                     std::uint64_t noise_scale, PrivacyContext const& privacy,
+                                     std::uint64_t fixed_point_scale,
+                                     std::uint64_t tree_index, std::uint32_t depth) {
+  auto pairs = CheckedAddSize(raw.cells_.size(), include_root_total ? 1 : 0);
+  auto coordinates = CheckedMultiplySize(pairs, 2);
+  CHECK_LE(coordinates, static_cast<std::size_t>(DSFLOWER_DP_MAX_VECTOR_LENGTH))
+      << "dsFlower public histogram geometry exceeds the reviewed sampler call bound";
+
+  std::vector<std::int64_t> input(coordinates);
+  std::size_t cursor{0};
+  if (include_root_total) {
+    CHECK_EQ(raw.totals_.size(), 1);
+    input[cursor++] = raw.totals_.front().gradient;
+    input[cursor++] = raw.totals_.front().hessian;
+  }
+  for (auto const& cell : raw.cells_) {
+    input[cursor++] = cell.gradient;
+    input[cursor++] = cell.hessian;
+  }
+  CHECK_EQ(cursor, input.size());
+
+  std::vector<std::int64_t> output(input.size());
+  auto domain = MakeReleaseDomain(tree_index, depth);
+  auto const& key = privacy.noise_key.Get();
+  auto status = dsflower_dp_add_discrete_gaussian_i64(
+      input.data(), input.size(), noise_scale, key.data(), key.size(), domain.data(),
+      domain.size(), output.data());
+  SecureZero(input.data(), input.size());
+  CHECK_EQ(status, DSFLOWER_DP_OK) << "dsFlower exact discrete-Gaussian primitive failed closed";
+
+  PrivateLevelHistogram result;
+  result.has_root_total_ = include_root_total;
+  result.bins_ = raw.bins_;
+  cursor = 0;
+  if (include_root_total) {
+    result.root_total_ = Decode({output[cursor], output[cursor + 1]}, privacy, fixed_point_scale);
+    cursor += 2;
+  }
+  result.cells_.reserve(raw.cells_.size());
+  for (std::size_t i = 0; i < raw.cells_.size(); ++i) {
+    result.cells_.push_back(
+        Decode({output[cursor], output[cursor + 1]}, privacy, fixed_point_scale));
+    cursor += 2;
+  }
+  SecureZero(output.data(), output.size());
+  return result;
+}
+
+void ProjectHessians(PrivateLevelHistogram* level, std::size_t node,
+                     PublicHistogramSchema const& schema, double parent_hessian) {
+  auto cap = std::max(0.0, parent_hessian);
+  for (std::size_t feature = 0; feature < schema.Features(); ++feature) {
+    auto begin = schema.FeatureOffset(feature);
+    auto end = schema.MissingBin(feature) + 1;
+    std::vector<double> sorted;
+    sorted.reserve(end - begin);
+    double sum{0.0};
+    for (auto bin = begin; bin < end; ++bin) {
+      auto& hessian = level->Cell(node, bin).hessian;
+      hessian = std::max(0.0, hessian);
+      sorted.push_back(hessian);
+      sum += hessian;
+    }
+    if (sum <= cap) {
+      continue;
+    }
+    std::sort(sorted.begin(), sorted.end(), std::greater<double>());
+    double prefix{0.0};
+    double theta{0.0};
+    for (std::size_t i = 0; i < sorted.size(); ++i) {
+      prefix += sorted[i];
+      auto candidate = (prefix - cap) / static_cast<double>(i + 1);
+      if (i + 1 == sorted.size() || sorted[i + 1] <= candidate) {
+        theta = candidate;
+        break;
+      }
+    }
+    for (auto bin = begin; bin < end; ++bin) {
+      auto& hessian = level->Cell(node, bin).hessian;
+      hessian = std::max(0.0, hessian - theta);
+    }
+  }
+}
+
+float FiniteFloat(double value) {
+  if (std::isnan(value)) {
+    return 0.0f;
+  }
+  auto maximum = static_cast<double>(std::numeric_limits<float>::max());
+  return static_cast<float>(std::max(-maximum, std::min(maximum, value)));
+}
+
+double NodeWeight(TrainParam const& train, PrivateStatistic const& statistic) {
+  auto weight = CalcWeight(train, statistic.gradient, statistic.hessian);
+  CHECK(std::isfinite(weight)) << "dsFlower DP leaf weight must remain finite";
+  return weight;
+}
+
+double NodeGain(TrainParam const& train, PrivateStatistic const& statistic) {
+  auto gain = CalcGain(train, statistic.gradient, statistic.hessian);
+  return std::isfinite(gain) ? gain : static_cast<double>(std::numeric_limits<float>::max());
+}
+
+struct SplitCandidate {
+  bool valid{false};
+  std::size_t feature{0};
+  std::size_t cut{0};
+  bool default_left{false};
+  double gain{0.0};
+  PrivateStatistic left;
+  PrivateStatistic right;
+};
+
+void ConsiderCandidate(TrainParam const& train, std::size_t feature, std::size_t cut,
+                       bool default_left, PrivateStatistic const& left,
+                       PrivateStatistic const& right, double parent_gain, SplitCandidate* best) {
+  if (!IsValidSplit(train, left.hessian, right.hessian)) {
+    return;
+  }
+  auto gain = NodeGain(train, left) + NodeGain(train, right) - parent_gain;
+  if (!std::isfinite(gain)) {
+    gain = static_cast<double>(std::numeric_limits<float>::max());
+  }
+  if (!best->valid || gain > best->gain) {
+    *best = {true, feature, cut, default_left, gain, left, right};
+  }
+}
+
+SplitCandidate BestSplit(TrainParam const& train, PrivateLevelHistogram const& level,
+                         std::size_t node, PublicHistogramSchema const& schema,
+                         PrivateStatistic const& parent) {
+  SplitCandidate best;
+  auto parent_gain = NodeGain(train, parent);
+  for (std::size_t feature = 0; feature < schema.Features(); ++feature) {
+    auto begin = schema.FeatureOffset(feature);
+    auto missing_bin = schema.MissingBin(feature);
+    auto present_bins = missing_bin - begin;
+    std::vector<PrivateStatistic> suffix(present_bins + 1);
+    for (std::size_t i = present_bins; i > 0; --i) {
+      suffix[i - 1] = suffix[i];
+      suffix[i - 1].Add(level.Cell(node, begin + i - 1));
+    }
+    auto const& missing = level.Cell(node, missing_bin);
+    PrivateStatistic prefix;
+    for (std::size_t cut = 0; cut < schema.CutCount(feature); ++cut) {
+      prefix.Add(level.Cell(node, begin + cut));
+      auto left_missing = prefix;
+      left_missing.Add(missing);
+      ConsiderCandidate(train, feature, cut, true, left_missing, suffix[cut + 1], parent_gain,
+                        &best);
+
+      auto right_missing = suffix[cut + 1];
+      right_missing.Add(missing);
+      ConsiderCandidate(train, feature, cut, false, prefix, right_missing, parent_gain, &best);
+    }
+  }
+  return best;
+}
+
+struct ActiveNode {
+  bst_node_t node{RegTree::kRoot};
+  PrivateStatistic total;
+};
+
+void ValidatePublicGeometry(PublicHistogramSchema const& schema, std::uint64_t max_depth) {
+  CHECK_GT(max_depth, 0);
+  CHECK_LE(max_depth, 30) << "dsFlower DP core supports XGBoost depths from one to 30";
+  auto active = static_cast<std::size_t>(UINT64_C(1) << (max_depth - 1));
+  auto cells = CheckedMultiplySize(active, schema.TotalBins());
+  auto coordinates = CheckedMultiplySize(CheckedAddSize(cells, 1), 2);
+  CHECK_LE(coordinates, static_cast<std::size_t>(DSFLOWER_DP_MAX_VECTOR_LENGTH))
+      << "dsFlower worst-case public tree geometry exceeds one exact-sampler vector";
+}
+
+void ValidatePrimitive() {
+  CHECK_EQ(dsflower_dp_primitives_abi_version(), DSFLOWER_DP_PRIMITIVES_ABI_VERSION)
+      << "dsFlower DP primitives ABI mismatch";
+  auto mechanism = dsflower_dp_primitives_mechanism_id();
+  CHECK(std::string_view{DSFLOWER_DP_MECHANISM_ID} == kExpectedPrimitiveMechanism &&
+        mechanism != nullptr && std::string_view{mechanism} == kExpectedPrimitiveMechanism)
+      << "dsFlower DP primitives mechanism mismatch";
+}
+
+void ValidateTraining(TrainParam const& train, PrivacyContext const& privacy, std::size_t rows,
+                      PublicHistogramSchema const& schema) {
+  CHECK_EQ(static_cast<std::uint64_t>(train.max_depth), privacy.max_depth)
+      << "dsFlower max_depth changed after privacy-context binding";
+  CHECK_EQ(train.max_leaves, 0) << "dsFlower DP core requires depthwise max_depth growth";
+  CHECK_EQ(train.grow_policy, TrainParam::kDepthWise)
+      << "dsFlower DP core requires depthwise growth";
+  CHECK_EQ(train.subsample, 1.0f);
+  CHECK_EQ(train.sampling_method, TrainParam::kUniform);
+  CHECK_EQ(train.colsample_bynode, 1.0f);
+  CHECK_EQ(train.colsample_bylevel, 1.0f);
+  CHECK_EQ(train.colsample_bytree, 1.0f);
+  CHECK(train.monotone_constraints.empty() && train.interaction_constraints.empty())
+      << "dsFlower DP core does not yet support tree constraints";
+  CHECK(std::isfinite(train.learning_rate) && train.learning_rate > 0.0f &&
+        train.learning_rate <= 1.0f)
+      << "dsFlower DP core requires a finite learning rate in (0, 1]";
+  CHECK(std::isfinite(train.max_delta_step) && train.max_delta_step > 0.0f)
+      << "dsFlower DP core requires an explicit positive leaf-weight clip";
+  CHECK(std::isfinite(train.reg_lambda) && train.reg_lambda > 0.0f)
+      << "dsFlower DP core requires positive L2 denominator protection";
+  CHECK(privacy.fixed_point_scale > 0 && privacy.fixed_point_scale <= kMaxFixedPointScale);
+  CHECK(privacy.root_noise_scale > 0 && privacy.root_noise_scale <= DSFLOWER_DP_MAX_EXACT_INTEGER);
+  CHECK(privacy.level_noise_scale > 0 &&
+        privacy.level_noise_scale <= DSFLOWER_DP_MAX_EXACT_INTEGER);
+  CHECK_LE(rows, static_cast<std::size_t>(std::numeric_limits<std::int64_t>::max() /
+                                          static_cast<std::int64_t>(privacy.fixed_point_scale)))
+      << "dsFlower row count and fixed-point scale exceed checked accumulator capacity";
+  ValidatePublicGeometry(schema, privacy.max_depth);
+  ValidatePrimitive();
+}
