+/**
+ * Copyright 2026 Barcelona Institute for Global Health (ISGlobal)
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#ifndef XGBOOST_PLUGIN_DSFLOWER_CONTEXT_H_
+#define XGBOOST_PLUGIN_DSFLOWER_CONTEXT_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+#include "xgboost/c_api.h"
+
+namespace xgboost::tree::dsflower {
+
+inline constexpr char kScaffoldMechanismId[] =
+    "dsflower.xgboost.dp_hist.v0-scaffold";
+inline constexpr std::size_t kNoiseKeySize = 32;
+
+struct PrivacyContext {
+  std::array<unsigned char, kNoiseKeySize> noise_key{};
+  std::string noise_key_id;
+  std::string privacy_epoch;
+  std::string node_id_hash;
+  std::string dataset_snapshot_hash;
+  std::string cohort_hash;
+  std::string query_hash;
+  std::string mechanism_config_hash;
+  std::string allocation_hash;
+  std::string privacy_unit;
+  std::string adjacency;
+  std::string unit_canonicalization;
+  std::string contribution_strategy;
+  double epsilon{0.0};
+  double delta{0.0};
+  double gradient_clip{0.0};
+  double hessian_clip{0.0};
+  std::uint64_t max_rows_per_unit{0};
+};
+
+bool TrySetPrivacyContext(const XGBDsFlowerPrivacyContext& input, std::string* error);
+void ClearPrivacyContext();
+bool PrivacyContextReady();
+
+}  // namespace xgboost::tree::dsflower
+
+#endif  // XGBOOST_PLUGIN_DSFLOWER_CONTEXT_H_
