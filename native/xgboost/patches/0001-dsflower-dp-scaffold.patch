@@ -0,0 +1,60 @@
+/**
+ * Copyright 2026 Barcelona Institute for Global Health (ISGlobal)
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#include "dsflower_context.h"
+
+#include <vector>
+
+#include "xgboost/gradient.h"
+#include "xgboost/json.h"
+#include "xgboost/logging.h"
+#include "xgboost/tree_updater.h"
+
+namespace xgboost::tree {
+
+DMLC_REGISTRY_FILE_TAG(dsflower_dp_hist_scaffold);
+
+class DsFlowerDpHistUpdater final : public TreeUpdater {
+ public:
+  explicit DsFlowerDpHistUpdater(Context const* ctx) : TreeUpdater{ctx} {}
+
+  void Configure(Args const&) override {
+    CHECK(dsflower::PrivacyContextReady())
+        << "dsFlower DP histogram updater requires a complete server-authoritative "
+           "privacy context on the calling thread";
+    configured_ = true;
+  }
+
+  void LoadConfig(Json const&) override {
+    // Context is intentionally neither serialized nor restored from a model.
+    configured_ = false;
+  }
+
+  void SaveConfig(Json* out) const override {
+    (*out)["name"] = String{Name()};
+    (*out)["status"] = String{"scaffold-only"};
+  }
+
+  [[nodiscard]] char const* Name() const override { return "grow_dsflower_dp_hist"; }
+
+  void Update(TrainParam const*, GradientContainer*, DMatrix*,
+              common::Span<HostDeviceVector<bst_node_t>>,
+              std::vector<RegTree*> const&) override {
+    CHECK(configured_ && dsflower::PrivacyContextReady())
+        << "dsFlower DP histogram updater was not configured with a complete privacy context";
+    LOG(FATAL) << "grow_dsflower_dp_hist is a fail-closed scaffold: histogram "
+                  "privatization has not been implemented or proven";
+  }
+
+ private:
+  bool configured_{false};
+};
+
+XGBOOST_REGISTER_TREE_UPDATER(DsFlowerDpHistUpdater, "grow_dsflower_dp_hist")
+    .describe("Fail-closed dsFlower DP histogram updater scaffold.")
+    .set_body([](Context const* ctx, ObjInfo const*) {
+      return new DsFlowerDpHistUpdater{ctx};
+    });
+
+}  // namespace xgboost::tree
