+# dsFlower DP histogram updater scaffold
+
+This opt-in plugin is deliberately **not a DP implementation**.  It reserves a
+TreeUpdater name and a C ABI for server-authoritative privacy context.  It
+validates all required context pins, keeps the noise key out of serialized
+XGBoost configuration, and then rejects every training update.
+
+The v1 adapter boundary accepts only `privacy_unit=row|patient`,
+`adjacency=replace_one`, `unit_canonicalization=trim-utf8-v2`,
+`contribution_strategy=one-record-per-unit-v1`, and `max_rows_per_unit=1`.
+The server must materialize the DMatrix as one row per privacy unit before it
+crosses this ABI; this scaffold does not canonicalize or pool patients itself.
+
+The updater must remain unavailable to production integration until a later
+patch implements and proves all of the following before any data-dependent
+split, topology, leaf, metric, log, or model artifact can leave the trusted
+process:
+
+- patient-level contribution bounding;
+- public or privately selected bins;
+- cryptographically keyed, domain-separated noise;
+- privatized gradient/hessian histograms before split selection;
+- explicit composition accounting and replay-stable release identity;
+- tests covering every egress and failure path.
+
+Build only for scaffold verification with `-DPLUGIN_DSFLOWER_DP=ON`.  Selecting
+`grow_dsflower_dp_hist` always fails closed in this patch.
diff --git a/plugin/dsflower/dsflower_context.cc b/plugin/dsflower/dsflower_context.cc
new file mode 100644
index 0000000..78bb734
--- /dev/null
+++ b/plugin/dsflower/dsflower_context.cc
@@ -0,0 +1,193 @@
+/**
+ * Copyright 2026 Barcelona Institute for Global Health (ISGlobal)
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#include "dsflower_context.h"
+
+#include <algorithm>
+#include <cmath>
+#include <string_view>
+#include <utility>
+
+#include "../../src/c_api/c_api_error.h"
+#include "xgboost/logging.h"
+
+namespace xgboost::tree::dsflower {
+namespace {
+
+constexpr std::size_t kHashSize = 64;
+constexpr std::size_t kMaxTokenSize = 128;
+
+void SecureZero(unsigned char* ptr, std::size_t size) {
+  volatile unsigned char* out = ptr;
+  while (size-- != 0) {
+    *out++ = 0;
+  }
+}
+
+struct ContextSlot {
+  PrivacyContext value;
+  bool ready{false};
+
+  ~ContextSlot() { Reset(); }
+
+  void Reset() {
+    SecureZero(value.noise_key.data(), value.noise_key.size());
+    value = PrivacyContext{};
+    ready = false;
+  }
+};
+
+thread_local ContextSlot g_context;
+
+bool IsLowerHexHash(const char* value) {
+  if (value == nullptr) {
+    return false;
+  }
+  std::string_view text{value};
+  return text.size() == kHashSize &&
+         std::all_of(text.cbegin(), text.cend(), [](char c) {
+           return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+         });
+}
+
+bool IsToken(const char* value) {
+  if (value == nullptr) {
+    return false;
+  }
+  std::string_view text{value};
+  return !text.empty() && text.size() <= kMaxTokenSize &&
+         std::all_of(text.cbegin(), text.cend(), [](char c) {
+           return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                  (c >= '0' && c <= '9') || c == '.' || c == '_' ||
+                  c == ':' || c == '-';
+         });
+}
+
+bool Reject(std::string message, std::string* error) {
+  if (error != nullptr) {
+    *error = std::move(message);
+  }
+  return false;
+}
+
+}  // namespace
+
+bool TrySetPrivacyContext(const XGBDsFlowerPrivacyContext& input, std::string* error) {
+  if (g_context.ready) {
+    return Reject("dsFlower privacy context is already installed on this thread", error);
+  }
+  if (input.struct_size != sizeof(XGBDsFlowerPrivacyContext)) {
+    return Reject("dsFlower privacy context struct_size mismatch", error);
+  }
+  if (input.abi_version != XGB_DSFLOWER_PRIVACY_CONTEXT_ABI_VERSION) {
+    return Reject("unsupported dsFlower privacy context ABI version", error);
+  }
+  if (input.noise_key == nullptr || input.noise_key_size != kNoiseKeySize) {
+    return Reject("dsFlower noise_key must contain exactly 32 bytes", error);
+  }
+  if (std::all_of(input.noise_key, input.noise_key + input.noise_key_size,
+                  [](unsigned char value) { return value == 0; })) {
+    return Reject("dsFlower noise_key must not be all zero", error);
+  }
+  if (input.mechanism_id == nullptr ||
+      std::string_view{input.mechanism_id} != kScaffoldMechanismId) {
+    return Reject("dsFlower mechanism_id does not match this scaffold", error);
+  }
+  if (!IsLowerHexHash(input.noise_key_id) || !IsLowerHexHash(input.node_id_hash) ||
+      !IsLowerHexHash(input.dataset_snapshot_hash) || !IsLowerHexHash(input.cohort_hash) ||
+      !IsLowerHexHash(input.query_hash) || !IsLowerHexHash(input.mechanism_config_hash) ||
+      !IsLowerHexHash(input.allocation_hash)) {
+    return Reject("every dsFlower identity/configuration pin must be a lowercase SHA-256 hex digest",
+                  error);
+  }
+  if (!IsToken(input.privacy_epoch)) {
+    return Reject("dsFlower privacy_epoch is missing or malformed", error);
+  }
+  if (input.privacy_unit == nullptr ||
+      (std::string_view{input.privacy_unit} != "row" &&
+       std::string_view{input.privacy_unit} != "patient")) {
+    return Reject("dsFlower privacy_unit must be row or patient", error);
+  }
+  if (input.adjacency == nullptr || std::string_view{input.adjacency} != "replace_one") {
+    return Reject("dsFlower adjacency must be replace_one", error);
+  }
+  if (input.unit_canonicalization == nullptr ||
+      std::string_view{input.unit_canonicalization} != "trim-utf8-v2") {
+    return Reject("dsFlower unit_canonicalization must be trim-utf8-v2", error);
+  }
+  if (input.contribution_strategy == nullptr ||
+      std::string_view{input.contribution_strategy} != "one-record-per-unit-v1") {
+    return Reject("dsFlower contribution_strategy must be one-record-per-unit-v1", error);
+  }
+  if (!std::isfinite(input.epsilon) || input.epsilon <= 0.0) {
+    return Reject("dsFlower epsilon must be finite and positive", error);
+  }
+  if (!std::isfinite(input.delta) || input.delta <= 0.0 || input.delta >= 1.0) {
+    return Reject("dsFlower delta must be finite and strictly between zero and one", error);
+  }
+  if (!std::isfinite(input.gradient_clip) || input.gradient_clip <= 0.0 ||
+      !std::isfinite(input.hessian_clip) || input.hessian_clip <= 0.0) {
+    return Reject("dsFlower gradient and hessian clips must be finite and positive", error);
+  }
+  if (input.max_rows_per_unit != 1) {
+    return Reject("dsFlower max_rows_per_unit must equal one", error);
+  }
+
+  PrivacyContext next;
+  next.noise_key_id = input.noise_key_id;
+  next.privacy_epoch = input.privacy_epoch;
+  next.node_id_hash = input.node_id_hash;
+  next.dataset_snapshot_hash = input.dataset_snapshot_hash;
+  next.cohort_hash = input.cohort_hash;
+  next.query_hash = input.query_hash;
+  next.mechanism_config_hash = input.mechanism_config_hash;
+  next.allocation_hash = input.allocation_hash;
+  next.privacy_unit = input.privacy_unit;
+  next.adjacency = input.adjacency;
+  next.unit_canonicalization = input.unit_canonicalization;
+  next.contribution_strategy = input.contribution_strategy;
+  next.epsilon = input.epsilon;
+  next.delta = input.delta;
+  next.gradient_clip = input.gradient_clip;
+  next.hessian_clip = input.hessian_clip;
+  next.max_rows_per_unit = input.max_rows_per_unit;
+  g_context.value = std::move(next);
+  std::copy_n(input.noise_key, kNoiseKeySize, g_context.value.noise_key.begin());
+  g_context.ready = true;
+  return true;
+}
+
+void ClearPrivacyContext() { g_context.Reset(); }
+
+bool PrivacyContextReady() { return g_context.ready; }
+
+}  // namespace xgboost::tree::dsflower
+
+XGB_DLL int XGBDsFlowerSetPrivacyContext(const XGBDsFlowerPrivacyContext* context) {
+  API_BEGIN();
+  xgboost_CHECK_C_ARG_PTR(context);
+  std::string error;
+  CHECK(xgboost::tree::dsflower::TrySetPrivacyContext(*context, &error)) << error;
+  API_END();
+}
+
+XGB_DLL int XGBDsFlowerClearPrivacyContext(void) {
+  API_BEGIN();
+  xgboost::tree::dsflower::ClearPrivacyContext();
+  API_END();
+}
+
+XGB_DLL int XGBDsFlowerPrivacyContextReady(int* out_ready) {
+  API_BEGIN();
+  xgboost_CHECK_C_ARG_PTR(out_ready);
+  *out_ready = xgboost::tree::dsflower::PrivacyContextReady() ? 1 : 0;
+  API_END();
+}
+
+XGB_DLL int XGBDsFlowerPrivacyScaffoldStatus(const char** out_status) {
+  API_BEGIN();
+  xgboost_CHECK_C_ARG_PTR(out_status);
+  *out_status = "scaffold-only:no-dp-histogram-privatization";
+  API_END();
+}
