+/**
+ * @brief ABI version for the opt-in dsFlower privacy context.
+ *
+ * @warning This ABI belongs to a fail-closed development scaffold.  It does
+ * not make XGBoost training differentially private.
+ */
+#define XGB_DSFLOWER_PRIVACY_CONTEXT_ABI_VERSION 1U
+
+/**
+ * @brief Server-authoritative pins required by the dsFlower updater scaffold.
+ *
+ * Every pointer is borrowed only for the duration of
+ * XGBDsFlowerSetPrivacyContext.  The implementation copies validated values
+ * and never serializes noise_key into a model or XGBoost configuration.  The
+ * caller must pass a context-derived key, never its durable noise root.
+ * ABI v1 also requires a DMatrix already materialized as exactly one row per
+ * declared privacy unit; the updater never performs patient canonicalization.
+ */
+typedef struct XGBDsFlowerPrivacyContext {
+  uint32_t struct_size;
+  uint32_t abi_version;
+  const unsigned char *noise_key;
+  size_t noise_key_size;
+  const char *mechanism_id;
+  const char *noise_key_id;
+  const char *privacy_epoch;
+  const char *node_id_hash;
+  const char *dataset_snapshot_hash;
+  const char *cohort_hash;
+  const char *query_hash;
+  const char *mechanism_config_hash;
+  const char *allocation_hash;
+  const char *privacy_unit;
+  const char *adjacency;
+  const char *unit_canonicalization;
+  const char *contribution_strategy;
+  double epsilon;
+  double delta;
+  double gradient_clip;
+  double hessian_clip;
+  uint64_t max_rows_per_unit;
+} XGBDsFlowerPrivacyContext;
+
+/**
+ * @brief Install a validated privacy context on the calling thread.
+ *
+ * A second install fails until XGBDsFlowerClearPrivacyContext is called.
+ * This API returning success does not authorize training: the scaffold updater
+ * still rejects every update until histogram privatization is implemented and
+ * independently verified.
+ */
+XGB_DLL int XGBDsFlowerSetPrivacyContext(const XGBDsFlowerPrivacyContext *context);
+
+/** @brief Wipe and remove the calling thread's dsFlower privacy context. */
+XGB_DLL int XGBDsFlowerClearPrivacyContext(void);
+
+/** @brief Report whether every required context pin is present and valid. */
+XGB_DLL int XGBDsFlowerPrivacyContextReady(int *out_ready);
+
+/** @brief Return a static status string for deployment guards. */
+XGB_DLL int XGBDsFlowerPrivacyScaffoldStatus(const char **out_status);
+
 /**
  * @brief register callback function for LOG(INFO) messages -- helpful messages
  *        that are not errors.
